{
  "id": "pricing_table",
  "layoutType": "ComparisonGrid",
  "description": "Pricing/plan comparison table with feature rows and plan columns for side-by-side tiers.",
  "tags": ["pricing", "price", "plans", "tiers", "subscription", "cost", "package", "billing", "saas", "rate card"],
  "regions": [
    { "id": "header", "x": 0.05, "y": 0.04, "width": 0.9, "height": 0.07, "slot": "title" },
    { "id": "subheader", "x": 0.05, "y": 0.11, "width": 0.9, "height": 0.04, "slot": "subtitle" },
    { "id": "table", "x": 0.05, "y": 0.2, "width": 0.9, "height": 0.7, "slot": "sections" },
    { "id": "footer", "x": 0.05, "y": 0.95, "width": 0.9, "height": 0.03, "slot": "footer" }
  ],
  "connectors": [
    { "from": "table", "to": "table", "style": "line" }
  ],
  "constraints": {
    "maxMetrics": 0,
    "minMetrics": 0,
    "maxSections": 12,
    "minSections": 2,
