{
  "id": "process_timeline",
  "layoutType": "ProcessTimeline",
  "description": "Vertical step-by-step process timeline with numbered section cards connected by a dashed accent line.",
  "tags": ["timeline", "step", "steps", "roadmap", "process", "phase", "sequence", "journey", "workflow"],
  "regions": [
    { "id": "header", "x": 0.05, "y": 0.04, "width": 0.9, "height": 0.07, "slot": "title" },
    { "id": "subheader", "x": 0.05, "y": 0.11, "width": 0.9, "height": 0.04, "slot": "subtitle" },
    { "id": "metrics", "x": 0.05, "y": 0.17, "width": 0.9, "height": 0.1, "slot": "metrics" },
    { "id": "sections", "x": 0.05, "y": 0.3, "width": 0.9, "height": 0.6, "slot": "sections" },
    { "id": "footer", "x": 0.05, "y": 0.95, "width": 0.9, "height": 0.03, "slot": "footer" }
  ],
  "connectors": [
    { "from": "sections", "to": "sections", "style": "dashed-line" }
  ],
  "constraints": {
    "maxMetrics": 4,
    "minMetrics": 1,
    "maxSections": 8,
    "minSections": 2,
    "maxTitleLength": 80,
    "maxFooterLength": 64,
    "allowedAspectRatios": ["A4Poster", "Banner16_9", "Square1_1"]
  }
}
